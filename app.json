{
  "expo": {
    "name": "Quizzin",
    "slug": "quizzin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./app/assets/logo.png",
    "scheme": "quizzin",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quizzin.app"
    },
    "android": {
      "package": "com.quizzin.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./app/assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./app/assets/logo_text.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "API_URL": "http://192.168.1.15",
      "PORT": "5000",
      "MOCK": false,
      "MOCK_URL": "../api/quizzFR.json",
      "router": {},
      "eas": {
        "projectId": "fd569914-e67e-4286-92d6-031cb4165f43"
      }
    },
    "owner": "viannhey"
  }
}
