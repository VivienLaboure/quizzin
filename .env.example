# Configuration MongoDB Atlas
# Remplacez USER par votre username/email MongoDB Atlas
# Remplacez PASSWORD par votre password MongoDB Atlas
# Remplacez CLUSTER_URL par votre cluster URL (ex: questions.8qjv0.mongodb.net)
# Remplacez COLLECTION par le nom de votre base de données

# Utilisateur et mot de passe MongoDB Atlas
MONGODB_USER=your_mongodb_username
MONGODB_PASSWORD=your_mongodb_password

# Cluster MongoDB Atlas
MONGODB_CLUSTER=your_cluster.mongodb.net

# Base de données
MONGODB_COLLECTION=your_database_name

# Port du serveur Express
# À ne PAS définir sur Render : la plateforme fournit sa propre valeur via
# cette même variable, la fixer soi-même peut casser le routage.
PORT=5000

# Environnement (development/production)
NODE_ENV=development

# URL publique du serveur (informatif, affiché au démarrage)
BASE_URL=http://localhost:5000

# Secret de signature des tokens JWT — générez une valeur aléatoire longue,
# par ex. avec: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_jwt_secret

# Email (Resend — https://resend.com)
# Clé API depuis Resend > API Keys
RESEND_API_KEY=your_resend_api_key
# Expéditeur des emails. Le domaine de test onboarding@resend.dev fonctionne
# sans configuration DNS mais ne peut envoyer qu'à l'adresse du compte
# Resend. Remplacez par une adresse sur un domaine vérifié pour envoyer à
# n'importe quel utilisateur.
MAIL_FROM=Quizzin <onboarding@resend.dev>
